# ==============================================================================
# 自媒体全自动矩阵工厂 (AutoMedia-Factory) 环境配置模板
# 复制本文件为 .env 并按需调整参数
# ==============================================================================

# 基础目录配置 (留空默认使用当前工作目录，或指定独立高性能磁盘路径)
# G_BASE_DIR=G:\矩阵短视频

# 切片处理默认配置
DEFAULT_SLICE_DURATION=300.0  # 目标单片时长 (秒)，默认约 5 分钟
ENABLE_MEDAPIPE_FACE_TRACKING=true
ENABLE_SCENEDETECT=true
ENABLE_AUTO_EDITOR_TRIM=true

# 矩阵发布平台开关 (可选逗号分隔: xiaohongshu,douyin,youtube,instagram)
ACTIVE_PLATFORMS=xiaohongshu,douyin,youtube,instagram

# 定时调度模式发布作品数量
SCHEDULED_PUBLISH_COUNT=2
